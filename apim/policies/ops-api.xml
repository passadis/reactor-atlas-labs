<!--
  atlas-ops-api (/ops): the governed business API. Layers, in the order Episode 3 peels them:

  1. rate limit and quota   - cheapest check first; it also throttles a flood of bad tokens
  2. agent auth             - Entra token for api://atlas-gateway, role Atlas.Agent (401 / 403)
  3. contract               - request validated against the hand-written spec; a malformed body
                              is refused here and the backend never runs
  4. identity swap          - the caller's token is replaced by APIM's own managed identity; the
                              Function App accepts nothing else
  5. retry                  - 429 and 5xx retried with backoff; attempts counted and reported
  6. response contract      - a backend that breaks its own schema is caught here, not by the model
  7. envelope               - every gateway error is {code, message, correlation_id}

  Rate-limit key: the subscription when there is one. MCP tool calls routed from atlas-ops-mcp
  arrive without a subscription (the toolbox authenticates by identity), so they fall back to the
  client IP.
-->
<policies>
  <inbound>
    <base />
    <rate-limit-by-key calls="120" renewal-period="60" retry-after-header-name="Retry-After"
        remaining-calls-header-name="x-atlas-remaining-calls"
        counter-key="@(context.Subscription != null ? context.Subscription.Id : context.Request.IpAddress)" />
    <quota-by-key calls="5000" renewal-period="86400"
        counter-key="@(context.Subscription != null ? context.Subscription.Id : context.Request.IpAddress)" />
    <include-fragment fragment-id="atlas-agent-auth" />
    <choose>
      <when condition="@(context.Request.Method == "POST" || context.Request.Method == "PUT")">
        <validate-content unspecified-content-type-action="prevent" max-size="65536"
            size-exceeded-action="prevent" errors-variable-name="validationErrors">
          <content type="application/json" validate-as="json" action="prevent" />
        </validate-content>
      </when>
    </choose>
    <authentication-managed-identity resource="api://atlas-ops-api" output-token-variable-name="backend-token" />
    <set-header name="Authorization" exists-action="override">
      <value>@("Bearer " + (string)context.Variables["backend-token"])</value>
    </set-header>
    <set-header name="Ocp-Apim-Subscription-Key" exists-action="delete" />
    <set-backend-service backend-id="ops-api-backend" />
  </inbound>
  <backend>
    <retry condition="@(context.Response.StatusCode == 429 || context.Response.StatusCode >= 500)"
        count="3" interval="1" max-interval="8" delta="2" first-fast-retry="false">
      <set-variable name="attempts" value="@(context.Variables.GetValueOrDefault<int>("attempts", 0) + 1)" />
      <forward-request buffer-request-body="true" timeout="30" />
    </retry>
  </backend>
  <outbound>
    <base />
    <set-header name="x-atlas-gateway-attempts" exists-action="override">
      <value>@(context.Variables.GetValueOrDefault<int>("attempts", 1).ToString())</value>
    </set-header>
    <choose>
      <when condition="@(context.Response.StatusCode < 300)">
        <validate-content unspecified-content-type-action="ignore" max-size="1048576"
            size-exceeded-action="ignore" errors-variable-name="responseValidationErrors">
          <content type="application/json" validate-as="json" action="prevent" />
        </validate-content>
      </when>
    </choose>
  </outbound>
  <on-error>
    <base />
    <include-fragment fragment-id="atlas-error-envelope" />
  </on-error>
</policies>
